# URL publique du site (canonique, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://econxstat.ca

# Formulaire de contact — serveur SMTP (ex. : hébergeur courriel, Microsoft 365, Gmail Workspace)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=info@econxstat.ca
# Adresse d'expédition (doit être autorisée par le serveur SMTP)
CONTACT_FROM_EMAIL="ÉconXStat <no-reply@econxstat.ca>"
